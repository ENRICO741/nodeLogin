# Produção: copie para deploy/.env. Dev local: backend/.env só precisa de DATABASE_URL e JWT_SECRET.

# --- Banco ---
POSTGRES_USER=app
# Use só letras e números (vai dentro da URL de conexão). Gere com: openssl rand -hex 24
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=security_awareness
# Só dev local (Postgres do docker-compose.dev.yml). Em produção o compose monta a URL a partir das variáveis acima.
DATABASE_URL=postgres://app:app@localhost:5432/security_awareness

# --- API ---
PORT=4000
NODE_ENV=development
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRA_EM=7d
# URL pública do app, usada no link de redefinição de senha.
APP_URL=http://localhost:5173

# --- E-mail (SMTP). Vazio em dev = link de redefinição aparece no log da API. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_SENHA=
SMTP_REMETENTE="Guardião Digital <no-reply@exemplo.com>"

# --- Deploy (Caddy) ---
DOMAIN=app.exemplo.com
