# Copie para .env (raiz, usado pelo docker compose) ou backend/.env (dev local).

# --- Banco ---
POSTGRES_USER=app
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=security_awareness
# Dev local (Postgres do compose exposto em localhost:5432). No compose, a API monta a URL sozinha.
DATABASE_URL=postgres://app:troque-esta-senha@localhost:5432/security_awareness

# --- API ---
PORT=4000
NODE_ENV=development
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRA_EM=7d
# URL pública do app, usada no link de redefinição de senha.
APP_URL=http://localhost:5173
# Só em dev: origem do Vite liberada no CORS. Em produção front e API têm a mesma origem.
CORS_ORIGEM=http://localhost:5173

# --- E-mail (SMTP). Vazio em dev = link de redefinição aparece no log da API. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_SENHA=
SMTP_REMETENTE="Security Awareness <no-reply@exemplo.com>"

# --- Deploy (Caddy) ---
DOMAIN=app.exemplo.com
