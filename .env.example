# Produção: copie para .env na raiz (lido pelo docker-compose.prod.yml).
# Desenvolvimento não precisa de .env: o docker-compose.yml já traz tudo configurado.

# --- Banco ---
POSTGRES_USER=app
# Use só letras e números (vai dentro da URL de conexão). Gere com: openssl rand -hex 24
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=security_awareness

# --- API ---
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRA_EM=7d
# URL pública do app (link de redefinição de senha). Padrão: https://$DOMAIN
# APP_URL=

# --- E-mail (SMTP). Vazio = o link de redefinição só aparece no log da API. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_SENHA=
SMTP_REMETENTE="Guardião Digital <no-reply@exemplo.com>"

# --- Pesquisa do TCC ---
# Segredo dos pseudônimos nos CSVs exportados (16+ caracteres). Defina uma vez e não troque:
# trocar muda os pseudônimos. Vazio = derivado do JWT_SECRET. Gere com: openssl rand -hex 24
PESQUISA_SEGREDO=

# --- Deploy (Caddy) ---
# Domínio real = HTTPS automático. Use :80 só para testar localmente sem HTTPS.
DOMAIN=app.exemplo.com
